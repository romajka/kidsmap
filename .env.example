DJANGO_DEBUG=0
SERVE_MEDIA_FILES=1
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS=kidsmap.az,www.kidsmap.az,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://kidsmap.az,https://www.kidsmap.az
DJANGO_ADMIN_HOST=admin.kidsmap.az
PUBLIC_BASE_URL=https://kidsmap.az
USE_X_FORWARDED_HOST=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SECURE_CONTENT_TYPE_NOSNIFF=1
SECURE_REFERRER_POLICY=same-origin
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=0
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_TIMEOUT_SECONDS=3
INDEXNOW_MIN_INTERVAL_SECONDS=3600

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
DEFAULT_FROM_EMAIL=KidsMap <noreply@kidsmap.az>
SERVER_EMAIL=noreply@kidsmap.az
MEDIA_CACHE_MAX_AGE=604800

DB_NAME=kidsmap_prod
DB_USER=kidsmap_app
DB_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://kidsmap_app:replace-with-strong-db-password@postgres:5432/kidsmap_prod
REDIS_URL=redis://redis:6379/0

# Keep these only during the rollback window after the MariaDB cutover.
LEGACY_DB_NAME=kidsmap_prod
LEGACY_DB_USER=kidsmap_app
LEGACY_DB_PASSWORD=replace-with-old-mariadb-password
LEGACY_DB_ROOT_PASSWORD=replace-with-old-mariadb-root-password
LEGACY_DATABASE_URL=mariadb://kidsmap_app:replace-with-old-mariadb-password@db:3306/kidsmap_prod

USE_RUNSERVER=0
RUN_COLLECTSTATIC_ON_RELEASE=1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
