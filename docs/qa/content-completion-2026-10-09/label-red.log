s="km-section-body">\n\n<div class="km-form-row "><div class="km-field "><label>\xd0\x90\xd0\xb2\xd1\x82\xd0\xbe\xd1\x80 \xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbb\xd0\xbe\xd0\xb6\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f</label><div class="readonly">-</div></div></div><div class="km-form-row "><div class="km-field "><label>Verified specialist (person\'s account)</label><div class="readonly">-</div></div></div><div class="km-form-row "><div class="km-field "><label>Person verified at:</label><div class="readonly">-</div></div></div><div class="km-form-row "><div class="km-field "><label>Legacy owner (does not verify identity)</label><div class="readonly">-</div></div></div><div class="km-form-row "><div class="km-field "><label class="required" for="id_name">First and last name:</label><input type="text" name="name" class="vTextField" maxlength="255" required id="id_name"></div></div><div class="km-form-row "><div class="km-field "><label for="id_name_alt">Alternative name / Transliteration:</label><input type="text" name="name_alt" class="vTextField" maxlength="255" aria-describedby="id_name_alt_helptext" id="id_name_alt"><p class="help" id="id_name_alt_helptext">\xd0\x9d\xd0\xb0\xd0\xbf\xd1\x80\xd0\xb8\xd0\xbc\xd0\xb5\xd1\x80, \xd0\xbb\xd0\xb0\xd1\x82\xd0\xb8\xd0\xbd\xd0\xb8\xd1\x86\xd0\xb0/\xd0\xba\xd0\xb8\xd1\x80\xd0\xb8\xd0\xbb\xd0\xbb\xd0\xb8\xd1\x86\xd0\xb0 \xd0\xb4\xd0\xbb\xd1\x8f \xd0\xbf\xd0\xbe\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0</p></div></div><div class="km-form-row "><div class="km-field "><label for="id_slug">Slug:</label><input type="text" name="slug" class="vTextField" maxlength="255" id="id_slug"></div></div>\n\n</div></section><section class="km-specialist-section" id="km-sec-2"><div class="km-section-header"><h2 tabindex="-1">2. Photo and description</h2></div><div class="km-section-body">\n\n<div class="km-form-row "><div class="km-field "><legend for="id_photo">Profile photo:</legend><input type="file" name="photo" id="id_photo"></div></div><div class="km-form-row "><div class="km-field "><label for="id_bio_az">About (AZ):</label><textarea name="bio_az" cols="40" rows="10" class="vLargeTextField" id="id_bio_az">\n</textarea></div></div><div class="km-form-row "><div class="km-field "><label for="id_bio_ru">About (RU):</label><textarea name="bio_ru" cols="40" rows="10" class="vLargeTextField" id="id_bio_ru">\n</textarea></div></div><div class="km-form-row "><div class="km-field "><label for="id_bio_en">About (EN):</label><textarea name="bio_en" cols="40" rows="10" class="vLargeTextField" id="id_bio_en">\n</textarea></div></div>\n\n</div></section><section class="km-specialist-section" id="km-sec-3"><div class="km-section-header"><h2 tabindex="-1">3. Fields of activity</h2></div><div class="km-section-body">\n<label for="specialist-direction-search">Search directions</label><input type="search" id="specialist-direction-search" data-specialist-direction-search><p role="status" aria-live="polite" data-specialist-direction-count data-found="Found" data-selected="Selected"></p>\n<div class="km-form-row "><div class="km-field km-field--specializations"><legend class="required">Specializations:</legend><div class="related-widget-wrapper" data-model-ref="specialistspecialization">\n    <div id="id_specializations"><div>\n    <label for="id_specializations_0"><input type="checkbox" name="specializations" value="7" data-context="available-source" required id="id_specializations_0">\n Neuropediatrician</label>\n\n</div><div>\n    <label for="id_specializations_1"><input type="checkbox" name="specializations" value="3" data-context="available-source" required id="id_specializations_1">\n Defectologist</label>\n\n</div><div>\n    <label for="id_specializations_2"><input type="checkbox" name="specializations" value="2" data-context="available-source" required id="id_specializations_2">\n Speech Therapist</label>\n\n</div><div>\n    <label for="id_specializations_3"><input type="checkbox" name="specializations" value="8" data-context="a