">Age from:</label><input type="number" name="age_from" class="vIntegerField" min="0" id="id_age_from"></div><div class="km-field "><label class="inline" for="id_age_to">Age to:</label><input type="number" name="age_to" class="vIntegerField" min="0" id="id_age_to"></div></div>\n\n</div></section><section class="km-specialist-section" id="km-sec-5"><div class="km-section-header"><h2 tabindex="-1">5. Working languages</h2></div><div class="km-section-body">\n\n<div class="km-form-row km-form-row--multi"><div class="km-field "><label class="vCheckboxLabel" for="id_language_az">Azerbaijani</label><input type="checkbox" name="language_az" id="id_language_az"></div><div class="km-field "><label class="vCheckboxLabel inline" for="id_language_ru">Russian</label><input type="checkbox" name="language_ru" id="id_language_ru"></div><div class="km-field "><label class="vCheckboxLabel inline" for="id_language_en">English</label><input type="checkbox" name="language_en" id="id_language_en"></div></div>\n\n</div></section><section class="km-specialist-section" id="km-sec-6"><div class="km-section-header"><h2 tabindex="-1">6. Online / in person</h2></div><div class="km-section-body">\n\n<div class="km-form-row "><div class="km-field "><label class="required" for="id_consultation_format">Work format:</label><select name="consultation_format" id="id_consultation_format">\n  <option value="online">Online only</option>\n\n  <option value="offline">In-person only</option>\n\n  <option value="both" selected>Online and in-person</option>\n\n</select></div></div>\n\n</div></section><section class="km-specialist-section" id="km-sec-7"><div class="km-section-header"><h2 tabindex="-1">7. Price and duration</h2></div><div class="km-section-body">\n\n<div class="km-form-row km-form-row--multi"><div class="km-field "><label for="id_price_from">Price from (AZN):</label><input type="number" name="price_from" class="vIntegerField" min="0" id="id_price_from"></div><div class="km-field "><label class=