xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xba\xd0\xb8">\n                            </th>\n                        \n                    \n                        \n                            <th class="column-rejection_reason">Rejection reason\n                                \n                            </th>\n                        \n                    \n                    \n                </tr></thead>\n\n                <tbody>\n                \n                </tbody>\n            </table>\n        </fieldset>\n    </div>\n</div>\n</div>\n\n</div></section><section class="km-specialist-section" id="km-sec-11"><div class="km-section-header"><h2 tabindex="-1">11. Contacts</h2></div><div class="km-section-body">\n\n<div class="km-form-row "><div class="km-field "><label for="id_phone">Phone:</label><input type="text" name="phone" class="vTextField" maxlength="50" id="id_phone"></div></div><div class="km-form-row "><div class="km-field "><label for="id_whatsapp">WhatsApp:</label><input type="text" name="whatsapp" class="vTextField" maxlength="50" id="id_whatsapp"></div></div><div class="km-form-row "><div class="km-field "><label for="id_instagram">Instagram:</label><input type="text" name="instagram" class="vTextField" maxlength="255" id="id_instagram"></div></div><div class="km-form-row "><div class="km-field "><label for="id_website">Website:</label><input type="url" name="website" class="vURLField" maxlength="200" id="id_website"></div></div>\n\n</div></section><section class="km-specialist-section" id="km-sec-12"><div class="km-section-header"><h2 tabindex="-1">12. Moderation and publication</h2></div><div class="km-section-body">\n\n<div class="km-form-row "><div class="km-field "><label class="required" for="id_status">Moderation status:</label><select name="status" id="id_status">\n  <option value="draft" selected>Draft</option>\n\n  <option value="pending">Pending moderation</option>\n\n  <option value="published">Published</option>\n\n  <option value="rejected">Rejected</option>\n\n</select></div></div><div class="km-form-row "><div class="km-field "><label class="vCheckboxLabel" for="id_is_active">Active</label><input type="checkbox" name="is_active" id="id_is_active" checked></div></div><div class="km-form-row "><div class="km-field "><label for="id_rejection_reason">Rejection reason:</label><textarea name="rejection_reason" cols="40" rows="10" class="vLargeTextField" id="id_rejection_reason">\n</textarea></div></div><div class="km-form-row "><div class="km-field "><label>Average rating:</label><div class="readonly">0</div></div></div><div class="km-form-row "><div class="km-field "><label>Review count:</label><div class="readonly">0</div></div></div><div class="km-form-row "><div class="km-field "><label>Created at:</label><div class="readonly">-</div></div></div><div class="km-form-row "><div class="km-field "><label>Updated at:</label><div class="readonly">-</div></div></div>\n\n</div></section>\n</div></div>\n<div class="km-specialist-sticky-footer"><span role="status" aria-live="polite" data-specialist-save-status data-error="Changes were not saved. Check the errors." data-dirty="There are unsaved changes" data-saving="Saving\xe2\x80\xa6 Wait for the server response.">The new profile has not been saved yet</span>\n\n<div class="km-admin-sidebar-actions">\n    \n        <button type="submit" class="km-btn--sidebar km-btn--success" name="_save">\n            <i class="fas fa-save"></i> Save\n        </button>\n    \n\n    \n\n    \n\n    \n        <button type="submit" class="km-btn--sidebar km-btn--info" name="_addanother">\n            <i class="fas fa-plus"></i> \xd0\xa1\xd0\xbe\xd1\x85\xd1\x80\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb8 \xd0\xb4\xd0\xbe\xd0\xb1\xd0\xb0\xd0\xb2\xd0\xb8\xd1\x82\xd1\x8c \xd0\xb4\xd1\x80\xd1\x83\xd0\xb3\xd0\xbe\xd0\xb9\n        </button>\n    \n\n    \n        <button type="submit" class="km-btn--sidebar km-btn--info" na