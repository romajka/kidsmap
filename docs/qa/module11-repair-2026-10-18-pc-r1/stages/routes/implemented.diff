+{% extends "base.html" %}
+{% block navigation_motion %}<style>@view-transition{navigation:none}</style>{% endblock %}
+{% load i18n static catalog_i18n %}
+
+{% block title %}{{ seo_title }}{% endblock %}
+{% block meta_description %}{{ meta_description }}{% endblock %}
+
+{% block extra_head %}
+<link rel="stylesheet" href="{% static 'css/pages/specialists.css' %}" />
+<link rel="stylesheet" href="{% static 'css/pages/specialist_workspace.css' %}" />
+{% endblock %}
+
+{% block content %}
+<div class="km-specialist-detail-page km-specialists-detail">
+
+  <!-- Back button -->
+  <div>
+    <a href="{% url 'specialist_list' %}" class="km-back-link">
+      <i class="fas fa-arrow-left" aria-hidden="true"></i>
+      {% if language == "az" %}Pedaqoqlar və mütəxəssislər kataloquna qayıt{% elif language == "en" %}Back to educators and specialists{% else %}Назад к педагогам и специалистам{% endif %}
+    </a>
+  </div>
+
+  <!-- Profile Header Card -->
+  <section class="km-detail-header-card">
+    <div class="km-detail-photo-wrapper">
+      {% if specialist.photo %}
+        <img src="{{ specialist.photo.url }}" alt="{{ specialist.name }}" class="km-detail-photo" />
+      {% else %}
+        <div class="km-card-photo-placeholder km-detail-photo-placeholder">
+          <i class="fas fa-user-tie" aria-hidden="true"></i>
+        </div>
+      {% endif %}
+    </div>
+
+    <div class="km-detail-header-info">
+      <!-- Specialization tags -->
+      <div class="km-detail-tags-row">
+        {% for spec in specialist.specializations.all %}
+          <span class="km-spec-tag">
+            {{ spec.name_i18n }}
+          </span>
+        {% endfor %}
+
+
+      </div>
+
+      <!-- Name & Bio short -->
+      <h1 class="km-detail-name">
+        {{ specialist.name }}
+      </h1>
+      {% if specialist.name_alt %}
+        <p class="km-detail-name-alt">{{ specialist.name_alt }}</p>
+      {% endif %}
+      {% if can_manage_specialist %}<p><a href="{% url 'specialist_workspace_profile' specialist.pk %}">{% trans 'Управлять своим профилем' %}</a></p>{% elif claim_workspace_url %}<p><a href="{{ claim_workspace_url }}">{% trans 'Это мой профиль' %}</a></p>{% endif %}
+
+      <!-- Statistics bar -->
+      <div class="km-detail-stats-row">
+        {% if specialist.rating_count %}
+          <div class="km-detail-stat-item">
+            <span class="km-stars">
+              {% if specialist.rating_avg >= 4.75 %}★★★★★{% elif specialist.rating_avg >= 4.25 %}★★★★☆{% elif specialist.rating_avg >= 3.75 %}★★★☆☆{% elif specialist.rating_avg >= 3.25 %}★★☆☆☆{% else %}★☆☆☆☆{% endif %}
+            </span>
+            <b>{{ specialist.rating_avg|floatformat:1 }}</b> ({{ specialist.rating_count }} {% if language == "az" %}rəy{% elif language == "en" %}reviews{% else %}отзывов{% endif %})
+          </div>
+        {% else %}
+          <div class="km-detail-stat-item km-detail-stat-empty">
+            ★★★★★ {% if language == "az" %}Rəy yoxdur{% elif language == "en" %}No reviews{% else %}Нет отзывов{% endif %}
+          </div>
+        {% endif %}
+
+        {% if specialist.experience_years != None %}
+        <div class="km-detail-stat-item">
+          <b>{% if language == "az" %}Təcrübə{% elif language == "en" %}Experience{% else %}Стаж работы{% endif %}:</b>
+          {{ specialist.experience_years }} {% if language == "az" %}il{% elif language == "en" %}years{% else %}лет{% endif %}
+        </div>
+        {% endif %}
+
+        <div class="km-detail-stat-item">
+          <b>{% if language == "az" %}Uşaq yaşı{% elif language == "en" %}Child age{% else %}Возраст детей{% endif %}:</b>
+          {% if specialist.age_from or specialist.age_to %}
+            {% if specialist.age_from and specialist.age_to %}
+              {{ specialist.age_from }} – {{ specialist.age_to }} {% if language == "az" %}yaş{% else %}лет{% endif %}
+            {% elif specialist.age_from %}
+              {{ specialist.age_from }}+ {% if language == "az" %}yaş{% else %}лет{% endif %}
+            {% else %}
+              &le; {{ specialist.age_to }} {% if language == "az" %}yaş{% else %}лет{% endif %}
+            {% endif %}
+          {% else %}
+            {% if language == "az" %}Hər hansı yaş{% elif language == "en" %}Any age{% else %}Любой возраст{% endif %}
+          {% endif %}
+        </div>
+      </div>
+    </div>
+  </section>
+
+  <!-- Two column content section -->
+  <div class="km-detail-columns">
+
+    <!-- Left column: Main Content -->
+    <div class="km-detail-main-column">
+
+      <!-- About -->
+      {% if specialist.bio_ru or specialist.bio_az or specialist.bio_en %}
+        <section class="km-detail-section">
+          <h2>
+            <i class="fas fa-user-tie" aria-hidden="true"></i>
+            {% if language == "az" %}Mütəxəssis haqqında{% elif language == "en" %}About the specialist{% else %}О специалисте{% endif %}
+          </h2>
+          <div class="km-bio-content">
+            {% localized_content specialist 'bio' as section_content %}{% include 'catalog/includes/localized_content.html' with content=section_content %}
+          </div>
+        </section>
+      {% endif %}
+
+      {% if specialist_current_employment %}
+      <section class="km-detail-section sw-public-employment" id="specialist-current-employment">
+        <h2>{% trans 'Текущее сотрудничество' %}</h2>
+        <ul>
+          {% for employment in specialist_current_employment %}
+            <li>
+              <h3>
