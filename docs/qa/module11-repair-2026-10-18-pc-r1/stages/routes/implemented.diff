+<!-- Star rating interactivity script -->
+<script>
+  document.addEventListener("DOMContentLoaded", function() {
+    const starBtns = document.querySelectorAll("#rating-stars-picker .km-star-btn");
+    const ratingInput = document.getElementById("selected-rating-val");
+
+    if (starBtns && ratingInput) {
+      starBtns.forEach(btn => {
+        btn.addEventListener("mouseover", function() {
+          highlightStars(parseInt(btn.getAttribute("data-val")));
+        });
+
+        btn.addEventListener("mouseout", function() {
+          highlightStars(parseInt(ratingInput.value) || 0);
+        });
+
+        btn.addEventListener("click", function() {
+          const val = parseInt(btn.getAttribute("data-val"));
+          ratingInput.value = val;
+          highlightStars(val);
+        });
+      });
+
+      function highlightStars(val) {
+        starBtns.forEach(btn => {
+          const btnVal = parseInt(btn.getAttribute("data-val"));
+          if (btnVal <= val) {
+            btn.style.color = "var(--km-warning)";
+          } else {
+            btn.style.color = "var(--km-gray-300)";
+          }
+        });
+      }
+    }
+  });
+</script>
