+          <div class="km-state-card km-state-card--filter" role="status">
+            <div class="km-state-card__icon-box">
+              <span class="material-symbols-rounded km-state-card__icon" aria-hidden="true">{% if active_filter_chips or selected.q %}search_off{% else %}person_search{% endif %}</span>
+            </div>
+            <h3 class="km-state-card__title">
+              {% if active_filter_chips or selected.q %}
+                {% if language == "az" %}Mütəxəssis tapılmadı{% elif language == "en" %}No specialists found{% else %}Специалисты не найдены{% endif %}
+              {% else %}
+                {% if language == "az" %}Kataloqda hələ mütəxəssis yoxdur{% elif language == "en" %}No specialists in catalog yet{% else %}В каталоге пока нет специалистов{% endif %}
+              {% endif %}
+            </h3>
+            <p class="km-state-card__desc">
+              {% if active_filter_chips or selected.q %}
+                {% if language == "az" %}Axtarış parametrlərinizə uyğun mütəxəssis tapılmadı. Parametrləri dəyişin və ya bütün filtrləri sıfırlayın.{% elif language == "en" %}No specialists match your search criteria. Try adjusting the filters or resetting them.{% else %}По выбранным критериям поиска и фильтрам подходящих специалистов не найдено. Попробуйте изменить параметры или сбросить фильтры.{% endif %}
+              {% else %}
+                {% if language == "az" %}Təsdiqlənmiş pedaqoq və ekspertlər tezliklə əlavə olunacaq. Siz həmçinin uşaq mərkəzləri kataloquna baxa bilərsiniz.{% elif language == "en" %}Verified educators will be listed soon. You can also browse our places catalog.{% else %}Анкеты проверенных педагогов и экспертов появятся здесь в ближайшее время. Вы можете ознакомиться с кружками в основном каталоге.{% endif %}
+              {% endif %}
+            </p>
+            <div class="km-state-card__actions">
+              {% if active_filter_chips or selected.q %}
+                <a href="{{ reset_filters_url }}" class="km-state-btn km-state-btn--primary">
+                  <span class="material-symbols-rounded" aria-hidden="true">restart_alt</span>
+                  <span>{% if language == "az" %}Bütün filtrləri sıfırla{% elif language == "en" %}Reset all filters{% else %}Сбросить все фильтры{% endif %}</span>
+                </a>
+              {% else %}
+                <a href="{% url 'place_list' %}" class="km-state-btn km-state-btn--primary">
+                  <span class="material-symbols-rounded" aria-hidden="true">explore</span>
+                  <span>{% if language == "az" %}Bütün məkanlara bax{% elif language == "en" %}Browse all places{% else %}Смотреть все заведения{% endif %}</span>
+                </a>
+              {% endif %}
+            </div>
+          </div>
+        {% endfor %}
+      </div>
+
+      <!-- Pagination -->
+      {% if page_obj.has_other_pages %}
+        <nav class="km-pagination" aria-label="{% if language == 'az' %}Səhifələmə{% elif language == 'en' %}Pagination{% else %}Пагинация{% endif %}">
+          {% url 'specialist_list' as specialist_list_url %}
+          {% if page_obj.has_previous %}
+            <a class="km-pagination-btn" href="{{ specialist_list_url }}?{% if specialist_query_without_page %}{{ specialist_query_without_page }}&amp;{% endif %}page={{ page_obj.previous_page_number }}" aria-label="{% if language == 'az' %}Əvvəlki səhifə{% elif language == 'en' %}Previous page{% else %}Предыдущая страница{% endif %}">
+              &larr;
+            </a>
+          {% endif %}
+
+          {% for num in page_obj.paginator.page_range %}
+            {% if page_obj.number == num %}
+              <span class="km-pagination-btn active" aria-current="page">{{ num }}</span>
+            {% else %}
+              <a class="km-pagination-btn" href="{{ specialist_list_url }}?{% if specialist_query_without_page %}{{ specialist_query_without_page }}&amp;{% endif %}page={{ num }}">
+                {{ num }}
+              </a>
+            {% endif %}
+          {% endfor %}
+
+          {% if page_obj.has_next %}
+            <a class="km-pagination-btn" href="{{ specialist_list_url }}?{% if specialist_query_without_page %}{{ specialist_query_without_page }}&amp;{% endif %}page={{ page_obj.next_page_number }}" aria-label="{% if language == 'az' %}Növbəti səhifə{% elif language == 'en' %}Next page{% else %}Следующая страница{% endif %}">
+              &rarr;
+            </a>
+          {% endif %}
+        </nav>
+      {% endif %}
+
+    </div>
+  </div>
+</div>
+
+{% endblock %}
