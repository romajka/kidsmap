+          <input
+            type="search"
+            name="q"
+            value="{{ selected.q }}"
+            placeholder="{% if language == 'az' %}Ad, istiqamət və ya xidmət...{% elif language == 'en' %}Name, specialization, or service...{% else %}Имя, направление или услуга...{% endif %}"
+            aria-label="{% if language == 'az' %}Axtarış{% elif language == 'en' %}Search{% else %}Поиск{% endif %}"
+          >
+          <button type="submit">
+            <span>{% if language == "az" %}Axtar{% elif language == "en" %}Search{% else %}Найти{% endif %}</span>
+          </button>
+        </form>
+
+        <!-- Popular Directions Chips -->
