+def build_sitewide_schema_payload(*, request, site_name: str, logo_url: str = "", social_urls: list[str] | None = None) -> dict:
+    home_url = _absolute_uri(request, reverse("home"))
+    catalog_url = _absolute_uri(request, reverse("place_list"))
