+            "target": f"{catalog_url}?q={{search_term_string}}",
+            "query-input": "required name=search_term_string",
+        },
+    }
+
+    return {
+        "organization_schema_json": _serialize_json_ld(organization),
+        "website_schema_json": _serialize_json_ld(website),
