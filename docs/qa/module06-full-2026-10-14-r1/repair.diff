 /* Shared venues retain independently navigable business cards. */
 .catalog-map-venue { background: var(--surface, #fff); border-radius: 18px; position: relative; padding-top: 32px; max-height: min(65vh, 560px); overflow-y: auto; overscroll-behavior: contain; }
