+from django.conf import settings
+from django.test import TestCase,override_settings
+from django.urls import reverse
+from django.utils import translation
+from catalog.models import SiteSettings,CatalogContentSettings
+from catalog.models.site import clear_singleton_caches
+from catalog.testcases.test_site_qa10_retired_recovery import StatusParser
+
+@override_settings(DEBUG=False,ROOT_URLCONF='config.urls')
+class Site12PublicNotFoundRecoveryTests(TestCase):
+    def setUp(self):
+        self.assertTrue(settings.TESTING);clear_singleton_caches();self.site=SiteSettings.get_solo();CatalogContentSettings.get_solo()
+    def page(self,lang):
+        self.client.cookies['django_language']=lang
+        with translation.override(lang):home=reverse('home');catalog=reverse('place_list')
+        r=self.client.get(home+'missing-site12-page/');self.assertEqual(r.status_code,404);p=StatusParser();p.feed(r.content.decode());return r,p,home,catalog
+    def test_debug_false_404_has_localized_heading_and_recovery(self):
+        for lang,title in {'az':'Bu səhifə əlçatan deyil','ru':'Страница недоступна','en':'This page is unavailable'}.items():
+            with self.subTest(lang=lang):
+                _,p,home,catalog=self.page(lang);self.assertEqual(p.heading.strip(),title);self.assertEqual(p.main,1);self.assertIn(home,p.links);self.assertIn(catalog,p.links)
+    def test_404_is_not_indexable(self):
+        for lang in ('az','ru','en'):
+            with self.subTest(lang=lang):
+                _,p,_,_=self.page(lang);self.assertEqual(p.robots,{'robots':'noindex, follow','googlebot':'noindex, follow'})
+    def test_recovery_links_work_and_missing_page_stays_404(self):
+        _,_,home,catalog=self.page('en')
+        for url in [home,catalog]:self.assertEqual(self.client.get(url).status_code,200)
+    def test_404_does_not_echo_query_tokens_or_change_settings(self):
+        before=SiteSettings.objects.values().get(pk=self.site.pk);r=self.client.get('/en/missing-site12-page/',{'token':'site12-fictional-private'},follow=True);self.assertEqual(r.status_code,404);self.assertNotIn('site12-fictional-private',r.content.decode());self.assertEqual(before,SiteSettings.objects.values().get(pk=self.site.pk))
