--- a/static/css/pages/account_notifications.css
+++ b/static/css/pages/account_notifications.css
@@ -0,0 +1,36 @@
+/* Inbox-only presentation; account navigation comes from account_profile.css. */
+.account-notifications .account-main-layout { min-width: 0; }
+.account-notifications .account-main-content { gap: 16px; }
+.account-notifications__title { margin: 0; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; }
+.account-notifications__intro { margin: 0; color: var(--muted); line-height: 1.5; }
+.account-notifications .account-notifications__list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
+.account-notifications .account-notifications__item {
+  display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16px;
+  min-width: 0; padding: 18px; border: 1px solid var(--tint-line-200);
+  border-radius: 16px; background: var(--surface);
+}
+.account-notifications .account-notifications__item.is-unread { border-inline-start: 4px solid var(--brand-turf); }
+.account-notifications__meta { display: flex; flex: 1 1 220px; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; overflow-wrap: anywhere; }
+.account-notifications__meta strong { color: var(--ink); font-size: 1rem; line-height: 1.4; }
+.account-notifications__meta time { color: var(--muted); font-size: .875rem; }
+.account-notifications__unread { color: var(--brand-spruce); background: var(--tint-turf-100); border-radius: 999px; padding: 3px 9px; font-size: .8125rem; font-weight: 700; }
+.account-notifications__actions { display: flex; flex: 0 1 auto; flex-wrap: wrap; align-items: flex-start; gap: 8px; min-width: 0; max-width: 100%; }
+.account-notifications__actions form { margin: 0; min-width: 0; max-width: 100%; }
+.account-notifications .account-notifications__action {
+  min-height: 44px; height: auto; max-width: 100%; width: auto; padding: 10px 16px;
+  justify-content: center; white-space: normal; overflow-wrap: anywhere; line-height: 1.4;
+  border: 1px solid var(--brand-turf); border-radius: 12px;
+  background: var(--brand-turf); color: var(--surface) !important; box-shadow: none;
+}
+.account-notifications .account-notifications__action:hover { background: var(--brand-spruce); transform: none; }
+.account-notifications .account-notifications__action--secondary { background: var(--surface); color: var(--brand-turf) !important; }
+.account-notifications .account-notifications__action--secondary:hover { background: var(--tint-turf-050); }
+.account-notifications :is(a, button):focus-visible { outline: 3px solid var(--brand-turf); outline-offset: 3px; }
+.account-notifications__empty, .account-notifications__error { margin: 0; padding: 20px; border: 1px solid var(--tint-line-200); border-radius: 16px; background: var(--surface); line-height: 1.5; }
+.account-notifications__error { border-color: var(--tone-danger-border); background: var(--tone-danger-bg); color: var(--ink); }
+@media (max-width: 600px) {
+  .account-notifications .account-notifications__item { padding: 14px; }
+  .account-notifications__actions { flex-basis: 100%; width: 100%; }
+  .account-notifications__actions form { flex: 1 1 140px; }
+  .account-notifications .account-notifications__action { width: 100%; }
+}
