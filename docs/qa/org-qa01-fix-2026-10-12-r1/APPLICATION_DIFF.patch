@@ -0,0 +1,173 @@
+"""Organization autosave follows approval without relaxing private-draft CAS."""
+import json
+from html.parser import HTMLParser
+
+from django.contrib.auth import get_user_model
+from django.test import Client, TestCase
+from django.urls import reverse
+
+from catalog.models import Organization, ServerDraft
+from catalog.services import publication
+
+
+class EditFormParser(HTMLParser):
+    def __init__(self, content):
+        super().__init__()
+        self.attrs = {}
+        self.feed(content.decode())
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == 'form' and 'data-org-edit-form' in attrs:
+            self.attrs = attrs
+
+
+class OrganizationAutosaveBaseTests(TestCase):
+    def setUp(self):
+        user = get_user_model()
+        self.owner = user.objects.create_user(username='orgqa01_owner')
+        self.other = user.objects.create_user(username='orgqa01_other')
+        self.staff = user.objects.create_superuser(
+            username='orgqa01_staff', email='orgqa01-staff@example.invalid', password='fictional',
+        )
+        self.org = Organization.objects.create(
+            owner=self.owner, created_by=self.owner, name_az='Fictional organization', name_en='Original',
+        )
+        self.client.force_login(self.owner)
+        self.detail_url = reverse('organization_workspace_detail', args=[self.org.pk])
+        self.draft_url = reverse('server_draft_collection')
+
+    def draft_body(self, value, **extra):
+        self.org.refresh_from_db()
+        return {
+            'target_type': 'organization', 'target_id': self.org.pk,
+            'schema_version': publication.SCHEMA_VERSION, 'source_version': self.org.content_version,
+            'expected_version': 0, 'fields': {'name_en': value}, **extra,
+        }
+
+    def autosave(self, body, client=None):
+        return (client or self.client).post(
+            self.draft_url, data=json.dumps(body), content_type='application/json',
+        )
+
+    def submit(self, name):
+        self.org.refresh_from_db()
+        revision = getattr(self.org, 'content_revision', None)
+        response = self.client.post(reverse('organization_workspace_save', args=[self.org.pk]), {
+            'name_az': self.org.name_az, 'name_en': name,
+            'expected_version': self.org.content_version,
+            'revision_version': revision.version if revision else 0, 'submit': '1',
+        })
+        self.assertEqual(response.status_code, 302, response.content)
+        self.org.refresh_from_db()
+        return self.org.content_revision
+
+    def approve(self, revision):
+        publication.review(actor=self.staff, revision_id=revision.pk, version=revision.version, approve=True)
+        self.org.refresh_from_db()
+        self.assertEqual(self.org.content_version, 2)
+
+    def form_autosave_body(self, response, value):
+        attrs = EditFormParser(response.content).attrs
+        self.assertTrue(attrs, 'Editable organization form was not rendered')
+        return {
+            'target_type': 'organization', 'target_id': self.org.pk,
+            'schema_version': int(attrs['data-schema-version']),
+            'source_version': int(attrs['data-source-version']),
+            'draft_id': attrs['data-draft-id'] or None,
+            'expected_version': int(attrs['data-draft-version']), 'fields': {'name_en': value},
+        }
+
+    def test_approval_allows_fresh_autosave_and_independent_resume_without_live_write(self):
+        initial = self.autosave(self.draft_body('Before approval'))
+        self.assertEqual(initial.status_code, 201, initial.content)
+        stale_id = initial.json()['draft_id']
+        self.approve(self.submit('Before approval'))
+        detail = self.client.get(self.detail_url)
+        fresh = self.autosave(self.form_autosave_body(detail, 'After approval'))
+        self.assertEqual(fresh.status_code, 201, fresh.content)
+        self.assertNotEqual(fresh.json()['draft_id'], stale_id)
+        updated = self.autosave(self.draft_body(
+            'After approval updated', draft_id=fresh.json()['draft_id'], expected_version=1,
+        ))
+        self.assertEqual(updated.status_code, 200, updated.content)
+        another = Client()
+        another.force_login(self.owner)
+        resumed = another.get(self.detail_url)
+        self.assertEqual(resumed.context['candidate_form']['name_en'].value(), 'After approval updated')
+        self.assertEqual(str(resumed.context['server_draft'].pk), fresh.json()['draft_id'])
+        old = ServerDraft.objects.get(pk=stale_id)
+        self.assertEqual((old.source_version, old.version, old.fields), (1, 1, {'name_en': 'Before approval'}))
+        self.org.refresh_from_db()
+        self.assertEqual((self.org.status, self.org.name_en), ('published', 'Before approval'))
+        self.assertEqual(self.org.content_revision.payload['name_en'], 'Before approval')
+
+    def test_current_draft_wins_over_newer_obsolete_base_and_foreign_actor_rows(self):
+        self.approve(self.submit('Approved'))
+        current = self.autosave(self.draft_body('Current working copy'))
+        self.assertEqual(current.status_code, 201, current.content)
+        ServerDraft.objects.create(actor=self.owner, target_type='organization', target_id=self.org.pk,
+                                   source_version=1, fields={'name_en': 'Obsolete working copy'})
+        ServerDraft.objects.create(actor=self.other, target_type='organization', target_id=self.org.pk,
+                                   source_version=2, fields={'name_en': 'Foreign working copy'})
+        response = self.client.get(self.detail_url)
+        self.assertEqual(response.context['candidate_form']['name_en'].value(), 'Current working copy')
+        self.assertEqual(str(response.context['server_draft'].pk), current.json()['draft_id'])
+
+    def test_incompatible_schema_cannot_bind_or_overlay_current_form(self):
+        ServerDraft.objects.create(actor=self.owner, target_type='organization', target_id=self.org.pk,
+                                   source_version=1, schema_version=publication.SCHEMA_VERSION + 1,
+                                   fields={'name_en': 'Incompatible schema'})
+        response = self.client.get(self.detail_url)
+        body = self.form_autosave_body(response, 'Supported schema')
+        self.assertIsNone(body['draft_id'])
+        self.assertEqual(response.context['candidate_form']['name_en'].value(), 'Original')
+        self.assertEqual(self.autosave(body).status_code, 201)
+
+    def test_newer_submitted_candidate_is_not_hidden_by_older_working_draft(self):
+        draft = self.autosave(self.draft_body('Old working copy')).json()
+        revision = self.submit('New submitted candidate')
+        response = self.client.get(self.detail_url)
+        self.assertEqual(response.context['candidate_form']['name_en'].value(), 'New submitted candidate')
+        updated = self.autosave(self.draft_body('Newest working copy', draft_id=draft['draft_id'], expected_version=1))
+        self.assertEqual(updated.status_code, 200, updated.content)
+        response = self.client.get(self.detail_url)
+        self.assertEqual(response.context['candidate_form']['name_en'].value(), 'Newest working copy')
+        current = self.client.get(self.detail_url + '?current=1')
+        self.assertEqual(current.context['candidate_form']['name_en'].value(), 'New submitted candidate')
+        revision.refresh_from_db()
+        self.assertEqual((revision.status, revision.version, revision.payload['name_en']),
+                         ('pending', 1, 'New submitted candidate'))
+        self.org.refresh_from_db()
+        self.assertEqual(self.org.name_en, 'Original')
+
+    def test_real_concurrent_draft_version_still_conflicts_without_overwriting_winner(self):
+        draft = self.autosave(self.draft_body('Initial')).json()
+        second = Client()
+        second.force_login(self.owner)
+        first_body = self.form_autosave_body(self.client.get(self.detail_url), 'Winner')
+        second_body = self.form_autosave_body(second.get(self.detail_url), 'Loser')
+        self.assertEqual(self.autosave(first_body).status_code, 200)
+        conflict = self.autosave(second_body, second)
+        self.assertEqual(conflict.status_code, 409, conflict.content)
+        self.assertEqual(conflict.json()['submitted_fields']['name_en'], 'Loser')
+        saved = ServerDraft.objects.get(pk=draft['draft_id'])
+        self.assertEqual((saved.version, saved.fields['name_en']), (2, 'Winner'))
+
+    def test_explicit_obsolete_draft_remains_a_conflict_after_approval(self):
+        draft = self.autosave(self.draft_body('Before approval')).json()
+        self.approve(self.submit('Approved'))
+        conflict = self.autosave(self.draft_body('Do not rebase', draft_id=draft['draft_id'], expected_version=1))
+        self.assertEqual(conflict.status_code, 409, conflict.content)
+        saved = ServerDraft.objects.get(pk=draft['draft_id'])
+        self.assertEqual((saved.source_version, saved.version, saved.fields['name_en']), (1, 1, 'Before approval'))
+
+    def test_foreign_actor_cannot_read_or_update_private_organization_draft(self):
+        draft = self.autosave(self.draft_body('Private')).json()
+        second = Client()
+        second.force_login(self.other)
+        self.assertEqual(second.get(self.detail_url).status_code, 404)
+        self.assertEqual(second.get(reverse('server_draft_detail', args=[draft['draft_id']])).status_code, 403)
+        denied = self.autosave(self.draft_body('Intrusion', draft_id=draft['draft_id'], expected_version=1), second)
+        self.assertEqual(denied.status_code, 403, denied.content)
+        self.assertEqual(ServerDraft.objects.get(pk=draft['draft_id']).fields['name_en'], 'Private')
