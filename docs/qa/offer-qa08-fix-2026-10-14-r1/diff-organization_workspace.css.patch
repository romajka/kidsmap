--- incoming-WORKTREE/static/css/pages/organization_workspace.css
+++ approved-WORKTREE/static/css/pages/organization_workspace.css
@@ -1298,3 +1298,20 @@
 @media (max-width: 600px) { .org-recovery { padding: 18px; margin: 16px 0; } .org-pending-row[data-join-request] { flex-wrap: wrap; } }
 
 .org-pending-row[data-join-request] .org-text-action { min-height: 44px; display: inline-flex; align-items: center; padding: 10px 12px; }
+
+/* Program decisions: terminal proposals stay separate from editable content. */
+.org-program-decision,
+.org-program-proposal {
+  min-width: 0;
+  max-width: 100%;
+  box-sizing: border-box;
+  overflow-wrap: anywhere;
+}
+.org-program-decision { display: block; }
+.org-program-decision-note,
+.org-program-proposal dd {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.org-program-proposal dt { font-weight: 600; }
+.org-program-proposal dd { margin: 4px 0 16px; }
