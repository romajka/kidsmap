n></a>\n  <a href="/account/places/" class="account-nav-item " ><span class="material-symbols-rounded" aria-hidden="true">location_on</span><span class="account-nav-text">M\xc9\x99nim m\xc9\x99kanlar\xc4\xb1m</span></a>\n  <a href="/account/organizations/" class="account-nav-item is-active" aria-current="page"><span class="material-symbols-rounded" aria-hidden="true">corporate_fare</span><span class="account-nav-text">T\xc9\x99\xc5\x9fkilatlar</span></a>\n  <a href="/account/specialists/" class="account-nav-item "><span class="material-symbols-rounded" aria-hidden="true">person</span><span class="account-nav-text">M\xc3\xbct\xc9\x99x\xc9\x99ssis kabineti</span></a>\n  <a href="/account/places/reviews/" class="account-nav-item " ><span class="material-symbols-rounded" aria-hidden="true">star</span><span class="account-nav-text">R\xc9\x99yl\xc9\x99rim</span></a>\n  <a href="/account/favorites/" class="account-nav-item " ><span class="material-symbols-rounded" aria-hidden="true">favorite</span><span class="account-nav-text">Se\xc3\xa7ilmi\xc5\x9fl\xc9\x99r</span></a>\n  <a href="/account/notifications/" class="account-nav-item " ><span class="material-symbols-rounded" aria-hidden="true">notifications</span><span class="account-nav-text">Bildiri\xc5\x9fl\xc9\x99r</span></a>\n  <a href="/account/settings/" class="account-nav-item " ><span class="material-symbols-rounded" aria-hidden="true">settings</span><span class="account-nav-text">T\xc9\x99nziml\xc9\x99m\xc9\x99l\xc9\x99r</span></a>\n</nav>\n\n    <main class="account-main-content" id="organization-main">\n      \n        <!-- Workspace Detail Mode -->\n        <nav class="org-back">\n          <a href="/account/organizations/" class="org-back-link">\n            <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>\n            <span>T\xc9\x99\xc5\x9fkilatlar\xc4\xb1m siyah\xc4\xb1s\xc4\xb1na qay\xc4\xb1t</span>\n          </a>\n        </nav>\n\n        <header class="org-hero org-hero--detail">\n          <div>\n            <p class="org-eyebrow">KidsMap \xc2\xb7 T\xc9\x99\xc5\x9fkilat</p>\n            <h1>ORG01 Uydurma \xc5\x9f\xc9\x99b\xc9\x99k\xc9\x99</h1>\n            <div class="org-chips">\n              <!-- \xd0\x9f\xd1\x83\xd0\xb1\xd0\xbb\xd0\xb8\xd1\x87\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd1\x83\xd1\x81 -->\n              \n                <span class="org-status org-status--draft" title="Qaralama rejimind\xc9\x99">\n                  <span class="material-symbols-rounded" aria-hidden="true">edit_note</span>\n                  Qaralama\n                </span>\n              \n\n              <!-- \xd0\xa1\xd1\x82\xd0\xb0\xd1\x82\xd1\x83\xd1\x81 \xd0\xbc\xd0\xbe\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 -->\n              \n\n              <!-- \xd0\xa1\xd0\xb5\xd1\x80\xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x8b\xd0\xb9 \xd1\x87\xd0\xb5\xd1\x80\xd0\xbd\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xba -->\n              \n            </div>\n          </div>\n          \n            <a class="account-btn-action" href="#org-create-branch">\n              <span class="material-symbols-rounded" aria-hidden="true">add_location_alt</span>\n              <span>Filial \xc9\x99lav\xc9\x99 et</span>\n            </a>\n          \n        </header>\n\n        \n\n        <!-- Onboarding Hub / \xd0\xa1\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5 \xd1\x88\xd0\xb0\xd0\xb3\xd0\xb8 -->\n        <section class="org-onboarding-hub" aria-labelledby="org-onboarding-title">\n          <div class="org-onboarding-hub__head">\n            <span class="material-symbols-rounded" aria-hidden="true">checklist</span>\n            <h2 id="org-onboarding-title" class="org-onboarding-hub__title">\n              \xc5\x9e\xc9\x99b\xc9\x99k\xc9\x99nin i\xc5\x9f\xc9\x99 sal\xc4\xb1nmas\xc4\xb1 \xc3\xbc\xc3\xa7\xc3\xbcn n\xc3\xb6vb\xc9\x99ti add\xc4\xb1mlar\n            </h2>\n          </div>\n          <div class="org-onboarding-hub__steps">\n            <!-- \xd0\xa8\xd0\xb0\xd0\xb3 1: \xd0\xa1\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f -->\n            <div class="org-onboarding-step ">\n              <div class="org-onboarding-step__icon">\n                <span class="material-symbols-rounded" aria-hidden="true">radio_button_unchecked</span>\n              </div>\n              <div class="org-onboarding-step__content">\n                <strong>1. \xc5\x9e\xc9\x99b\xc9\x99k\xc9\x99 m\xc9\x99lumatlar\xc4\xb1n\xc4\xb1 doldurun</strong>\n                <p>T\xc9\x99svir, sayt v\xc9\x99 vahid \xc9\x99laq\xc9\x99 n\xc3\xb6mr\xc9\x99l\xc9\x99ri.</p>\n              </div>\n              <a href="#org-about" class="org-onboarding-step__btn">\n                Doldur \xe2\x86\x92\n              </a>\n            </div>\n\n            <!-- \xd0\xa8\xd0\xb0\xd0\xb3 2: \xd0\xa4\xd0\xb8\xd0\xbb\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8b -->\n            <div class="org-onboarding-step ">\n              <div class="org-onboarding-step__icon">\n                <span class="material-symbols-rounded" aria-hidden="true">radio_button_unchecked</span>\n              </div>\n              <div class="org-onboarding-step__content">\n                <strong>2. Filial yarad\xc4\xb1n v\xc9\x99 ya m\xc9\x99kan qo\xc5\x9fun</strong>\n                <p>Haz\xc4\xb1rda 0 filial m\xc3\xb6vcuddur.</p>\n              </div>\n              <a href="#org-branches" class="org-onboarding-step__btn">\n                Filial \xc9\x99lav\xc9\x99 et \xe2\x86\x92\n              </a>\n            </div>\n\n            <!-- \xd0\xa8\xd0\xb0\xd0\xb3 3: \xd0\x9a\xd0\xbe\xd0\xbc\xd0\xb0\xd0\xbd\xd0\xb4\xd0\xb0 -->\n            <div class="org-onboarding-step ">\n              <div class="org-onboarding-step__icon">\n                <span class="material-symbols-rounded" aria-hidden="true">radio_button_unchecked</span>\n              </div>\n              <div class="org-onboarding-step__content">\n                <strong>3. \xc6\x8fm\xc9\x99kda\xc5\x9flar\xc4\xb1 t\xc9\x99yin edin</strong>\n                <p>Menecerl\xc9\x99r v\xc9\x99 redaktorlar \xc3\xbc\xc3\xa7\xc3\xbcn h\xc3\xbcquqlar t\xc9\x99yin edin.</p>\n              </div>\n              <a href="#org-team" class="org-onboarding-step__btn">\n                D\xc9\x99v\xc9\x99t et \xe2\x86\x92\n              </a>\n            </div>\n          </div>\n        </section>\n\n        <!-- \xd0\xa0\xd0\xb0\xd0\xb7\xd0\xb4\xd0\xb5\xd0\xbb\xd1\x8b \xd0\xbd\xd0\xb0\xd0\xb2\xd0\xb8\xd0\xb3\xd0\xb0\xd1\x86\xd0\xb8\xd0\xb8 (Tabs) -->\n        <nav class="org-tabs" aria-label="T\xc9\x99\xc5\x9fkilat b\xc3\xb6lm\xc9\x99l\xc9\x99ri">\n          <a href="#org-overview">\xc4\xb0cmal</a>\n          <a href="#org-branches">Filiallar (0)</a>\n          <a href="#org-programs">Proqramlar (0)</a>\n          <a href="#org-team">Komanda</a>\n          <a href="#org-about">M\xc9\x99lumat v\xc9\x99 rekvizitl\xc9\x99r</a>\n        </nav>\n\n        \n          <p class="org-specialist-link-wrap">\n            <a class="account-btn-sm account-btn-sm--secondary" href="/account/organizations/106/specialists/">\n              <span class="material-symbols-rounded" aria-hidden="true">person</span>\n              <span>M\xc3\xbct\xc9\x99x\xc9\x99ssisl\xc9\x99rl\xc9\x99 \xc9\x99m\xc9\x99kda\xc5\x9fl\xc4\xb1q</span>\n            </a>\n          </p>\n        \n\n        <!-- \xd0\x9e\xd0\xb1\xd0\xb7\xd0\xbe\xd1\x80 (Overview) -->\n        <section id="org-overview" class="org-section" tabindex="-1">\n          <h2>\xc4\xb0cmal</h2>\n          <div class="org-metrics">\n            <p><strong>0</strong><span>G\xc3\xb6r\xc3\xbcn\xc9\x99n filial</span></p>\n            <p><strong>0</strong><span>Proqram</span></p>\n          </div>\n          \n            <div class="org-alert" role="status">\n              <span class="material-symbols-rounded" aria-hidden="true">pending_actions</span>\n              <span>Qo\xc5\x9fulma t\xc9\x99sdiq g\xc3\xb6zl\xc9\x99yir (1 sor\xc4\x9fu)</span>\n            </div>\n          \n        </section>\n\n        <!-- \xd0\xa4\xd0\xb8\xd0\xbb\xd0\xb8\xd0\xb0\xd0\xbb\xd1\x8b (Branches) -->\n        <section id="org-branches" class="org-section" tabindex="-1">\n          <div class="org-section-head">\n            <h2>Filiallar</h2>\n            \n              <a href="#org-create-branch" class="org-text-action">+ Filial yarat</a>\n            \n          </div>\n\n          \n            <div class="org-empty" data-empty-branches>\n              <span class="material-symbols-rounded" aria-hidden="true">location_on</span>\n              <h3>H\xc9\x99l\xc9\x99 filial yoxdur</h3>\n              <p>T\xc9\x99\xc5\x9fkilat filial olmadan m\xc3\xb6vcud ola bil\xc9\x99r. \xc4\xb0st\xc9\x99diyiniz vaxt yeni filial yarada v\xc9\x99 ya \xc3\xb6z m\xc9\x99kan\xc4\xb1n\xc4\xb1z\xc4\xb1 qo\xc5\x9fa bil\xc9\x99rsiniz.</p>\n            </div>\n          \n\n          \n            <div class="org-action-panel org-control-panel" id="org-create-branch">\n              <h3>Yeni filial yarat</h3>\n              <form class="org-control-form" method="post" action="/account/organizations/106/branches/create/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="[redacted]">\n                \n                <div class="org-fields org-control-grid">\n                  <label class="org-control-field">\n                    <span>Filial\xc4\xb1n ad\xc4\xb1 (AZ) <span aria-hidden="true">*</span></span>\n                    <input type="text" name="name_az" maxlength="255" required id="id_branch_name_az">\n                    \n                  </label>\n                  <label class="org-control-field">\n                    <span>Kateqoriya <span aria-hidden="true">*</span></span>\n                    <select name="category_id" required id="id_branch_category_id">\n  <option value="" selected>---------</option>\n\n  <option value="[redacted]">\xc4\xb0dman</option>\n\n  <option value="[redacted]">Su istirah\xc9\x99ti</option>\n\n  <option value="[redacted]">Parklar v\xc9\x99 u\xc5\x9faq meydan\xc3\xa7alar\xc4\xb1</option>\n\n  <option value="[redacted]">\xc6\x8fyl\xc9\x99nc\xc9\x99 v\xc9\x99 asud\xc9\x99 vaxt</option>\n\n  <option value="[redacted]">Zooparklar</option>\n\n  <option value="[redacted]">Muzeyl\xc9\x99r v\xc9\x99 m\xc9\x99d\xc9\x99niyy\xc9\x99t</option>\n\n  <option value="[redacted]">R\xc9\x99qsl\xc9\x99r</option>\n\n  <option value="[redacted]">T\xc9\x99hsil</option>\n\n  <option value="[redacted]">M\xc9\x99kt\xc9\x99b\xc9\x99q\xc9\x99d\xc9\x99r inki\xc5\x9faf</option>\n\n  <option value="[redacted]">Yarad\xc4\xb1c\xc4\xb1l\xc4\xb1q</option>\n\n  <option value="[redacted]">Teatr v\xc9\x99 s\xc9\x99hn\xc9\x99</option>\n\n  <option value="[redacted]">Musiqi</option>\n\n  <option value="[redacted]">\xc4\xb0ntellekt v\xc9\x99 bacar\xc4\xb1qlar</option>\n\n  <option value="[redacted]">Elm v\xc9\x99 texnologiyalar</option>\n\n  <option value="[redacted]">\xc4\xb0nki\xc5\x9faf v\xc9\x99 d\xc9\x99st\xc9\x99k</option>\n\n  <option value="[redacted]">D\xc3\xbc\xc5\x9f\xc9\x99rg\xc9\x99l\xc9\x99r</option>\n\n  <option value="[redacted]">Ekskursiyalar v\xc9\x99 turlar</option>\n\n</select>\n                    \n                  </label>\n                </div>\n                \n                <button class="account-btn-action" type="submit">\n                  Filial yarat\n                </button>\n              </form>\n            </div>\n          \n\n          \n            <div class="org-action-panel">\n              <h3>Haz\xc4\xb1r m\xc9\x99kanlar\xc4\xb1 qo\xc5\x9f</h3>\n              <p>Kartlar\xc4\xb1 ad v\xc9\x99 \xc3\xbcnvana g\xc3\xb6r\xc9\x99 tap\xc4\xb1n. \xc5\x9e\xc9\x99kill\xc9\x99r, m\xc9\x99\xc5\x9f\xc4\x9f\xc9\x99l\xc9\x99l\xc9\x99r v\xc9\x99 qiym\xc9\x99tl\xc9\x99r saxlan\xc4\xb1lacaq.</p>\n              <a href="/account/organizations/106/connections/" class="account-btn-action">M\xc9\x99kanlar\xc4\xb1 tap v\xc9\x99 se\xc3\xa7</a>\n            </div>\n          \n\n          \n            <div class="org-action-panel">\n              <h3>G\xc3\xb6zl\xc9\x99y\xc9\x99n sor\xc4\x9fular</h3>\n              \n                \n<div class="org-pending-row" data-join-request="91">\n  <span>\n    \xc6\x8fl\xc3\xa7atan olmayan m\xc9\x99kan\n    \xc2\xb7 ORG01 Uydurma \xc5\x9f\xc9\x99b\xc9\x99k\xc9\x99\n    <small>Sahibl\xc9\x99rin t\xc9\x99sdiqi g\xc3\xb6zl\xc9\x99nilir.</small>\n  </span>\n  \n    <form method="post" action="/account/organizations/106/requests/91/confirm/"><input type="hidden" name="csrfmiddlewaretoken" value="[redacted]"><button class="org-text-action" type="submit">T\xc9\x99sdiql\xc9\x99</button></form>\n    <a class="org-text-action" href="/account/organizations/106/requests/91/recovery/">Sor\xc4\x9fuya bax v\xc9\x99 l\xc9\x99\xc4\x9fv et</a>\n  \n</div>\n\n              \n            </div>\n          \n        </section>\n\n        <!-- \xd0\x9f\xd1\x80\xd0\xbe\xd0\xb3\xd1\x80\xd0\xb0\xd0\xbc\xd0\xbc\xd1\x8b (Programs) -->\n        <section id="org-programs" class="org-section" tabindex="-1">\n          <h2>Proqramlar</h2>\n          \n            <p class="org-muted">H\xc9\x99l\xc9\x99 \xc3\xbcmumi proqram yoxdur.</p>\n          \n          \n            <div class="org-action-panel org-control-panel">\n              <h3>Proqram yarat</h3>\n              <form class="org-control-form" method="post" action="/account/organizations/106/programs/create/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="[redacted]">\n                <label class="org-control-field">\n                  <span>Proqram\xc4\xb1n ad\xc4\xb1 (AZ) <span aria-hidden="true">*</span></span>\n                  <input name="name_az" maxlength="255" required aria-describedby="org-program-create-hint">\n                </label>\n                <p class="org-control-hint" id="org-program-create-hint">Proqram\xc4\xb1n dig\xc9\x99r m\xc9\x99lumatlar\xc4\xb1 proqram redaktorunda doldurulur.</p>\n                <button class="account-btn-action" type="submit">Yarat</button>\n              </form>\n            </div>\n          \n        </section>\n\n        <!-- \xd0\xa1\xd0\xbe\xd1\x82\xd1\x80\xd1\x83\xd0\xb4\xd0\xbd\xd0\xb8\xd0\xba\xd0\xb8 (Team) -->\n        <section id="org-team" class="org-section" tabindex="-1">\n          <h2>Komanda</h2>\n          \n            <p class="org-muted">\xc4\xb0caz\xc9\x99l\xc9\x99r cari filiallara t\xc9\x99tbiq olunur. Se\xc3\xa7ilmi\xc5\x9f filiallar g\xc9\x99l\xc9\x99c\xc9\x99k filiallara \xc5\x9famil edilmir.</p>\n            <form method="post" action="/account/business/team/organization/106/invite/" class="org-team-form org-control-form" data-team-form data-team-list-url="/account/organizations/106/" data-team-url="/account/business/team/organization/106/invite/">\n              <input type="hidden" name="csrfmiddlewaretoken" value="[redacted]">\n              <p id="org-team-unavailable" data-team-unavailable role="status">\xc6\x8fm\xc9\x99kda\xc5\x9f\xc4\xb1 d\xc9\x99v\xc9\x99t etm\xc9\x99k \xc3\xbc\xc3\xa7\xc3\xbcn JavaScript laz\xc4\xb1md\xc4\xb1r. Forman\xc4\xb1 aktivl\xc9\x99\xc5\x9fdirm\xc9\x99k \xc3\xbc\xc3\xa7\xc3\xbcn brauzerd\xc9\x99 JavaScript-i yand\xc4\xb1r\xc4\xb1n v\xc9\x99 s\xc9\x99hif\xc9\x99ni yenil\xc9\x99yin. D\xc9\x99v\xc9\x99t g\xc3\xb6nd\xc9\x99rilm\xc9\x99yib.</p>\n              <div class="org-control-grid">\n                <label class="org-control-field">\n                  <span>Email <span aria-hidden="true">*</span></span>\n                  <input type="email" name="email" required disabled data-team-control>\n                </label>\n                <div class="org-control-field">\n                  <label for="org-team-role">Rol</label>\n                  <select id="org-team-role" name="role" aria-describedby="org-team-role-hint" data-team-role disabled data-team-control>\n                    <option value="[redacted]" data-summary="Filiallara bax\xc4\xb1\xc5\x9f v\xc9\x99 redakt\xc9\x99">Redaktor</option>\n                    <option value="[redacted]" data-summary="Filiallara bax\xc4\xb1\xc5\x9f, redakt\xc9\x99 v\xc9\x99 statistika">Menecer</option><option value="[redacted]" data-summary="Filiallara v\xc9\x99 statistikaya bax\xc4\xb1\xc5\x9f">M\xc3\xbc\xc5\x9fahid\xc9\x99\xc3\xa7i</option>\n                  </select>\n                  <p id="org-team-role-hint" class="org-control-hint" data-team-role-summary role="status">Filiallara bax\xc4\xb1\xc5\x9f v\xc9\x99 redakt\xc9\x99</p>\n                </div>\n                <label class="org-control-field org-control-wide">\n                  <span>\xc6\x8fhat\xc9\x99</span>\n                  <select name="scope" data-team-scope disabled data-team-control>\n                    <option value="[redacted]">B\xc3\xbct\xc3\xbcn \xc5\x9f\xc9\x99b\xc9\x99k\xc9\x99</option>\n                    <option value="[redacted]">Se\xc3\xa7ilmi\xc5\x9f filiallar</option>\n                  </select>\n                </label>\n              </div>\n              <p class="org-control-hint">Bu rollara d\xc9\x99rc, moderasiya v\xc9\x99 \xc9\x99m\xc9\x99kda\xc5\x9f idar\xc9\x99etm\xc9\x99si daxil deyil.</p>\n              <p class="org-control-hint">B\xc3\xbct\xc3\xbcn \xc5\x9f\xc9\x99b\xc9\x99k\xc9\x99 aktual biznes \xc9\x99laq\xc9\x99si olan g\xc9\x99l\xc9\x99c\xc9\x99k filiallar\xc4\xb1 da \xc9\x99hat\xc9\x99 edir. Se\xc3\xa7ilmi\xc5\x9f filiallar yaln\xc4\xb1z m\xc9\x99kan icaz\xc9\x99l\xc9\x99rini m\xc9\x99hdudla\xc5\x9fd\xc4\xb1r\xc4\xb1r. T\xc9\x99\xc5\x9fkilat v\xc9\x99 \xc3\xbcmumi proqramlar \xc3\xbc\xc3\xa7\xc3\xbcn ayr\xc4\xb1ca icaz\xc9\x99l\xc9\x99r b\xc3\xbct\xc3\xbcn t\xc9\x99\xc5\x9fkilata aiddir.</p>\n              <fieldset data-team-branches hidden>\n                <legend>Filiallar</legend>\n                <p class="org-control-hint">\xc6\x8fn az\xc4\xb1 bir cari filial se\xc3\xa7in.</p>\n                \n              </fieldset>\n              <button class="account-btn-action" type="submit" disabled data-team-control aria-describedby="org-team-unavailable">D\xc9\x99v\xc9\x99t et</button>\n              <p role="status" aria-live="polite" data-team-status></p>\n              <button class="account-btn-action" type="button" data-team-refresh hidden disabled data-team-control>D\xc9\x99v\xc9\x99t siyah\xc4\xb1s\xc4\xb1n\xc4\xb1 yenil\xc9\x99</button>\n            </form>\n            \n            <div data-team-invitations>\n            \n            </div>\n          \n        </section>\n\n        <!-- \xd0\xa1\xd0\xb2\xd0\xb5\xd0\xb4\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb8 \xd1\x80\xd0\xb5\xd0\xba\xd0\xb2\xd0\xb8\xd0\xb7\xd0\xb8\xd1\x82\xd1\x8b (About) -->\n        <section id="org-about" class="org-section" tabindex="-1">\n          <h2>M\xc9\x99lumat v\xc9\x99 rekvizitl\xc9\x99r</h2>\n\n          \n\n          \n\n          \n            <form method="post" action="/account/organizations/106/save/" data-org-edit-form   data-draft-url="/api/drafts/" data-source-version="1" data-schema-version="1" data-draft-id="" data-draft-version="0">\n              <input type="hidden" name="csrfmiddlewaretoken" value="[redacted]">\n              \n              <input type="hidden" name="expected_version" value="[redacted]" id="id_expected_version">\n              <input type="hidden" name="revision_version" value="[redacted]" id="id_revision_version">\n\n              <div class="org-fields">\n                <div class="org-editor-field"><label>\n                  Ad (AZ)\n                  <input type="text" name="name_az" value="[redacted]" maxlength="255" id="id_name_az">\n                </label>\n                  \n</div>\n                <div class="org-editor-field"><label>\n                  Ad (RU)\n                  <input type="text" name="name_ru" maxlength="255" id="id_name_ru">\n                </label>\n                  \n</div>\n                <div class="org-editor-field"><label>\n                  Ad (EN)\n                  <input type="