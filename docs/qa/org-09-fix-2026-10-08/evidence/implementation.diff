--- a/static/css/pages/organization_workspace.css
+++ b/static/css/pages/organization_workspace.css
@@ -1177,3 +1177,94 @@
 .org-team-form [data-team-refresh][hidden] {
   display: none;
 }
+
+
+/* ORG-09: branch, program and team creation controls. */
+.org-control-panel h3 { font-size: 20px; line-height: 1.35; }
+.org-control-form { min-width: 0; }
+.org-control-form .org-control-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 20px;
+}
+.org-control-form .org-control-field {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 0;
+  font-size: 15px;
+  font-weight: 600;
+  color: #17332a;
+}
+.org-control-form .org-control-wide { grid-column: 1 / -1; }
+.org-control-form input:not([type="checkbox"]):not([type="hidden"]),
+.org-control-form select {
+  box-sizing: border-box;
+  width: 100%;
+  min-width: 0;
+  min-height: 48px;
+  padding: 10px 14px;
+  font: inherit;
+  font-size: 16px;
+  font-weight: 400;
+  color: #17332a;
+  background: #fff;
+  border: 1.5px solid #c9d8ce;
+  border-radius: 10px;
+}
+.org-control-form :is(input, select, button):focus-visible {
+  outline: 3px solid #176d45;
+  outline-offset: 3px;
+}
+.org-control-form .account-btn-action {
+  min-height: 48px;
+  margin-top: 20px;
+  white-space: normal;
+}
+.org-control-form input:not([type="checkbox"]):not([type="hidden"]):disabled,
+.org-control-form select:disabled,
+.org-control-form button:disabled {
+  color: #52625a;
+  background: #e9eeeb;
+  border-color: #c9d8ce;
+  cursor: not-allowed;
+}
+.org-control-form .account-btn-action:disabled {
+  color: #52625a !important; /* Account buttons otherwise force white text. */
+  box-shadow: none;
+  transform: none;
+}
+.org-control-form .org-control-hint {
+  margin: 0;
+  font-size: 13.5px;
+  font-weight: 400;
+  line-height: 1.5;
+  color: #52665a;
+}
+.org-control-form > .org-control-hint { margin-top: 12px; }
+.org-control-form fieldset {
+  min-width: 0;
+  margin: 20px 0 0;
+  padding: 12px;
+  border: 1px solid #c9d8ce;
+  border-radius: 10px;
+}
+.org-control-form :is(.org-control-check, .org-check) {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 48px;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+}
+.org-control-form input[type="checkbox"] {
+  flex: 0 0 20px;
+  width: 20px;
+  height: 20px;
+  accent-color: #176d45;
+}
+.org-control-form .errorlist { margin: 0; padding-left: 20px; font-weight: 400; }
+@media (max-width: 600px) {
+  .org-control-form .org-control-grid { grid-template-columns: minmax(0, 1fr); }
+  .org-control-form .account-btn-action { width: 100%; justify-content: center; }
+}
