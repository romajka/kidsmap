+"""SOCIAL10: notification login recovery; candidate outside app until scope approval."""
+from urllib.parse import parse_qs,urlsplit
+from django.conf import settings
+from django.contrib.auth import get_user_model
+from django.test import Client,TestCase
+from django.urls import reverse
+from django.utils import translation
+from catalog.models import WorkflowNotification,EmailOutbox,OwnerTeamMembership,OrganizationGrant
+
+class SocialQA10NotificationLoginTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.user=get_user_model().objects.create_user('social10-user',email='social10@example.invalid',password='synthetic-social10-only')
+        cls.notice=WorkflowNotification.objects.create(event_kind='moderation_decision',entity_type='volunteer_revision',entity_id=91910,entity_version=1,recipient_key='user:'+str(cls.user.pk),recipient_user=cls.user,recipient_email=cls.user.email)
+
+    def url(self,name,lang,args=None):
+        with translation.override(lang):return reverse(name,args=args)
+
+    def actions(self,lang):
+        return [self.url('account_notification_'+action,lang,[self.notice.pk]) for action in ['read','accept','reject']]
+
+    def counts(self):
+        return (WorkflowNotification.objects.count(),EmailOutbox.objects.count(),OwnerTeamMembership.objects.count(),OrganizationGrant.objects.count())
+
+    def assert_login(self,response,path,lang):
+        self.assertEqual(response.status_code,302)
+        parsed=urlsplit(response.headers['Location'])
+        self.assertEqual(parsed.path,self.url('account_login',lang))
+        self.assertEqual(parse_qs(parsed.query).get('next'),[path])
+        self.assertEqual(parsed.netloc,'')
+
+    def test_guest_inbox_reaches_real_localized_login_with_full_next(self):
+        for lang in ['az','ru','en']:
+            with self.subTest(lang=lang):
+                c=Client();path=self.url('account_notifications',lang)+'?tab=all'
+                r=c.get(path);self.assert_login(r,path,lang)
+                self.assertEqual(c.get(r.headers['Location']).status_code,200)
+
+    def test_guest_get_action_urls_use_login_before_method_guard(self):
+        for lang in ['az','ru','en']:
+            for path in self.actions(lang):
+                with self.subTest(lang=lang,path=path):self.assert_login(Client().get(path),path,lang)
+
+    def test_guest_post_with_valid_csrf_redirects_without_business_writes(self):
+        before=self.counts()
+        for lang in ['az','ru','en']:
+            c=Client(enforce_csrf_checks=True);c.get(self.url('account_login',lang));token=c.cookies[settings.CSRF_COOKIE_NAME].value
+            for path in self.actions(lang):
+                with self.subTest(lang=lang,path=path):self.assert_login(c.post(path,HTTP_X_CSRFTOKEN=token),path,lang)
+        self.assertEqual(self.counts(),before);self.notice.refresh_from_db();self.assertIsNone(self.notice.read_at)
+
+    def test_guest_post_without_csrf_still_denied(self):
+        before=self.counts()
+        for path in self.actions('ru'):
+            with self.subTest(path=path):self.assertEqual(Client(enforce_csrf_checks=True).post(path).status_code,403)
+        self.assertEqual(self.counts(),before)
+
+    def test_authenticated_inbox_methods_and_read_replay_remain_intact(self):
+        self.client.force_login(self.user)
+        self.assertEqual(self.client.get(self.url('account_notifications','ru')).status_code,200)
+        for path in self.actions('ru'):
+            with self.subTest(path=path):self.assertEqual(self.client.get(path).status_code,405)
+        path=self.actions('ru')[0];self.assertEqual(self.client.post(path).status_code,302)
+        self.notice.refresh_from_db();stamp=self.notice.read_at;self.assertIsNotNone(stamp)
+        self.assertEqual(self.client.post(path).status_code,302);self.notice.refresh_from_db();self.assertEqual(self.notice.read_at,stamp)
+
+    def test_password_login_returns_to_original_inbox_not_action_replay(self):
+        for lang in ['az','ru','en']:
+            with self.subTest(lang=lang):
+                c=Client();path=self.url('account_notifications',lang)+'?tab=all';r=c.get(path);self.assert_login(r,path,lang)
+                login=c.post(r.headers['Location'],{'username':self.user.email,'password':'synthetic-social10-only','next':path})
+                self.assertEqual(login.status_code,302);self.assertEqual(login.headers['Location'],path)
+                self.assertEqual(c.get(path).status_code,200)
+
+    def test_password_login_still_rejects_external_next(self):
+        for target in ['https://outside.invalid/','//outside.invalid/']:
+            with self.subTest(target=target):
+                c=Client();r=c.post(self.url('account_login','ru'),{'username':self.user.email,'password':'synthetic-social10-only','next':target})
+                self.assertEqual(r.status_code,302);self.assertEqual(r.headers['Location'],self.url('account_profile','ru'))
+
+    def test_explicit_shared_account_guard_keeps_named_login(self):
+        for lang in ['az','ru','en']:
+            for name in ['account_dashboard','account_favorites','account_profile']:
+                with self.subTest(lang=lang,name=name):
+                    path=self.url(name,lang);self.assert_login(Client().get(path),path,lang)
