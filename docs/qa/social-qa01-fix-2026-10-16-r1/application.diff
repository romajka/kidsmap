+"""SOCIAL-QA-01: saved rating must survive the actual typed editor round trip."""
+from datetime import timedelta
+from html.parser import HTMLParser
+
+from django.contrib.auth import get_user_model
+from django.test import TestCase, override_settings
+from django.urls import reverse
+from django.utils import timezone
+from django.utils.translation import override
+
+from catalog.models import Activity, Event, SiteSettings, Specialist
+from catalog.services.review_versions import rating_summary, review_types
+from catalog.testcases.utils import create_ready_place
+
+
+class EditorRatingParser(HTMLParser):
+    def __init__(self, html):
+        super().__init__()
+        self.inside = False
+        self.options = []
+        self.feed(html)
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == 'select':
+            self.inside = attrs.get('id') == 'review-rating'
+        elif self.inside and tag == 'option':
+            self.options.append((attrs.get('value', ''), 'selected' in attrs))
+
+    def handle_endtag(self, tag):
+        if tag == 'select':
+            self.inside = False
+
+    @property
+    def value(self):
+        return next((value for value, selected in self.options if selected), self.options[0][0])
+
+
+@override_settings(PLACE_REVIEW_COOLDOWN_SECONDS=0)
+class TypedReviewRatingReadbackTests(TestCase):
+    def setUp(self):
+        users = get_user_model()
+        self.author = users.objects.create_user('social01-author', first_name='Fictional')
+        self.outsider = users.objects.create_user('social01-outsider')
+        self.staff = users.objects.create_superuser('social01-reviewer', 'reviewer@example.invalid', 'fixture')
+        place = create_ready_place()
+        self.targets = {
+            'place': place,
+            'activity': Activity.objects.create(place=place, status='published', name_az='Fictional activity'),
+            'specialist': Specialist.objects.create(name='Fictional specialist', status='published', is_active=True),
+            'event': Event.objects.create(name='Fictional event', name_az='Fictional event', category=place.category,
+                status='published', event_format='online', start_datetime=timezone.now()+timedelta(days=5),
+                end_datetime=timezone.now()+timedelta(days=5, hours=1)),
+        }
+        site = SiteSettings.get_solo()
+        site.events_section_enabled = site.specialists_section_enabled = True
+        site.save()
+
+    def url(self, kind):
+        return reverse('typed_reviews', args=[kind, self.targets[kind].pk])
+
+    def head(self, kind):
+        return review_types()[kind][1].objects.get(**{kind: self.targets[kind], 'user': self.author, 'is_current': True})
+
+    def submit(self, kind, rating, text, expected=None):
+        self.client.force_login(self.author)
+        response = self.client.post(self.url(kind), {'rating': rating, 'text': text, 'expected_revision_id': expected or ''})
+        self.assertEqual(response.status_code, 302, response.content[:200])
+        return self.head(kind)
+
+    def decide(self, kind, approve):
+        head = self.head(kind)
+        self.client.force_login(self.staff)
+        url = reverse('typed_review_action', args=[kind, head.pk, 'approve' if approve else 'reject'])
+        response = self.client.post(url, {'revision_id': head.candidate_revision_id, 'reason': 'Fictional reason'})
+        self.assertEqual(response.status_code, 302)
+        return self.head(kind)
+
+    def assert_editor(self, kind, rating, text, revision_id):
+        self.client.force_login(self.author)
+        for language in ('ru', 'az', 'en'):
+            with self.subTest(kind=kind, language=language), override(language):
+                response = self.client.get(self.url(kind))
+                self.assertEqual(response.status_code, 200)
+                html = response.content.decode()
+                self.assertIn('data-review-edit', html)
+                self.assertEqual(EditorRatingParser(html).value, str(rating))
+                self.assertContains(response, text, html=False)
+                self.assertContains(response, f'name="expected_revision_id" value="{revision_id}"')
+
+    def test_new_editor_and_foreign_candidate_have_empty_rating(self):
+        for kind in self.targets:
+            self.client.force_login(self.author)
+            response = self.client.get(self.url(kind))
+            self.assertEqual(EditorRatingParser(response.content.decode()).value, '')
+            self.submit(kind, 4, 'Author-only candidate')
+            self.client.force_login(self.outsider)
+            response = self.client.get(self.url(kind))
+            self.assertEqual(response.status_code, 200)
+            self.assertEqual(EditorRatingParser(response.content.decode()).value, '')
+            self.assertNotContains(response, 'Author-only candidate')
+
+    def test_pending_rating_is_restored(self):
+        for kind in self.targets:
+            head = self.submit(kind, 4, 'Pending four')
+            self.assertIsNone(head.current_revision_id)
+            self.assert_editor(kind, 4, 'Pending four', head.candidate_revision_id)
+
+    def test_approved_rating_is_restored(self):
+        for kind in self.targets:
+            self.submit(kind, 5, 'Approved five')
+            head = self.decide(kind, True)
+            self.assertIsNone(head.candidate_revision_id)
+            self.assert_editor(kind, 5, 'Approved five', head.current_revision_id)
+
+    def test_pending_edit_uses_candidate_and_preserves_live_rating(self):
+        for kind in self.targets:
+            self.submit(kind, 5, 'Live five')
+            live = self.decide(kind, True)
+            head = self.submit(kind, 2, 'Candidate two', live.current_revision_id)
+            self.assertEqual(head.rating, 5)
+            self.assertEqual(rating_summary(self.targets[kind]), {'average': 5.0, 'count': 1})
+            self.assert_editor(kind, 2, 'Candidate two', head.candidate_revision_id)
+
+    def test_first_rejection_retains_author_rating(self):
+        for kind in self.targets:
+            self.submit(kind, 3, 'Rejected three')
+            head = self.decide(kind, False)
+            self.assertIsNone(head.current_revision_id)
+            self.assertIsNone(head.candidate_revision_id)
+            self.assertEqual(head.rating, 3)
+            self.assert_editor(kind, 3, 'Rejected three', '')
+
+    def test_rejected_edit_restores_approved_rating(self):
+        for kind in self.targets:
+            self.submit(kind, 4, 'Live four')
+            live = self.decide(kind, True)
+            self.submit(kind, 1, 'Rejected candidate one', live.current_revision_id)
+            head = self.decide(kind, False)
+            self.assertIsNone(head.candidate_revision_id)
+            self.assertEqual(head.revisions.get(status='rejected').rating, 1)
+            self.assertEqual(rating_summary(self.targets[kind]), {'average': 4.0, 'count': 1})
+            self.assert_editor(kind, 4, 'Live four', head.current_revision_id)
+
+    def test_reload_then_resubmit_preserves_rating_and_escapes_text(self):
+        for kind in self.targets:
+            head = self.submit(kind, 4, 'Literal <b>text</b> & symbols')
+            self.client.force_login(self.author)
+            response = self.client.get(self.url(kind))
+            self.assertContains(response, 'Literal &lt;b&gt;text&lt;/b&gt; &amp; symbols')
+            selected = EditorRatingParser(response.content.decode()).value
+            self.assertEqual(selected, '4')
+            newer = self.submit(kind, selected, 'Literal <b>text</b> & symbols', head.candidate_revision_id)
+            self.assertEqual(newer.candidate_revision.rating, 4)
+            self.assertEqual(newer.revisions.count(), 2)
+            self.assertEqual(rating_summary(self.targets[kind])['count'], 0)
