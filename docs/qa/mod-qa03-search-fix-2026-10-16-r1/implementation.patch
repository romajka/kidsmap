+"""Submit the rendered search form, including its actual hidden controls."""
+from datetime import timedelta
+from html.parser import HTMLParser
+from urllib.parse import urlsplit
+
+from django.contrib import admin
+from django.contrib.auth import get_user_model
+from django.contrib.auth.models import Permission
+from django.http import QueryDict
+from django.test import TestCase
+from django.utils import timezone
+
+from catalog.models import Event, Place, Specialist
+
+
+class SearchControls(HTMLParser):
+    def __init__(self, html):
+        super().__init__(convert_charrefs=True)
+        self.inside = False
+        self.hidden = []
+        self.feed(html)
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == 'form':
+            self.inside = attrs.get('id') == 'changelist-search'
+        if self.inside and tag == 'input' and attrs.get('type') == 'hidden':
+            self.hidden.append((attrs['name'], attrs.get('value', '')))
+
+    def handle_endtag(self, tag):
+        if tag == 'form':
+            self.inside = False
+
+    def submission(self, query):
+        params = QueryDict(mutable=True)
+        for key, value in self.hidden:
+            params.appendlist(key, value)
+        params['q'] = query
+        return params
+
+
+class AdminQueueSearchStateTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.actor = get_user_model().objects.create_superuser('search-admin', 'search@example.invalid', 'synthetic')
+        cls.rows = {}
+        for model in (Place, Event, Specialist):
+            rows = []
+            for name, status in [('SEARCHQA Alpha', 'published'), ('SEARCHQA Beta', 'published'), ('SEARCHQA Draft', 'draft'), ('Outside', 'published')]:
+                values = {'name': name, 'status': status}
+                if model in (Place, Event):
+                    values.update(category_id='EDU', name_az=name, name_ru=name, name_en=name)
+                if model is Event:
+                    values.update(start_datetime=timezone.now() + timedelta(days=10))
+                else:
+                    values['is_active'] = True
+                rows.append(model.objects.create(**values).pk)
+            cls.rows[model] = rows
+
+    def setUp(self):
+        self.client.force_login(self.actor)
+
+    def url(self, model, lang='ru'):
+        return ('' if lang == 'az' else '/' + lang) + '/admin/catalog/' + model._meta.model_name + '/'
+
+    def page(self, model, params, lang='ru'):
+        response = self.client.get(self.url(model, lang), params)
+        self.assertEqual(response.status_code, 200, getattr(response, 'url', ''))
+        return response
+
+    def controls(self, response):
+        return SearchControls(response.content.decode())
+
+    def ids(self, response):
+        return [o.pk for o in response.context['cl'].result_list]
+
+    def test_native_form_parameters_keep_status_sort_and_matching_records_all_locales(self):
+        for model in self.rows:
+            for lang in ('ru', 'az', 'en'):
+                with self.subTest(model=model.__name__, lang=lang):
+                    first = self.page(model, {'status__exact': 'published', 'sort': 'name_asc'}, lang)
+                    params = self.controls(first).submission('SEARCHQA')
+                    self.assertEqual(params.getlist('status__exact'), ['published'])
+                    self.assertEqual(params['sort'], 'name_asc')
+                    submitted = self.page(model, params, lang)
+                    self.assertEqual(self.ids(submitted), self.rows[model][:2])
+                    self.assertEqual(submitted.context['cl'].query, 'SEARCHQA')
+
+    def test_repeated_supported_status_filter_values_survive_the_form(self):
+        for model in self.rows:
+            with self.subTest(model=model.__name__):
+                initial = QueryDict('status__exact=published&status__exact=draft&q=SEARCHQA&sort=name_asc')
+                first = self.page(model, initial)
+                self.assertEqual(self.ids(first), self.rows[model][:3])
+                params = self.controls(first).submission('SEARCHQA')
+                self.assertEqual(params.getlist('status__exact'), ['published', 'draft'])
+                self.assertEqual(self.ids(self.page(model, params)), self.rows[model][:3])
+
+    def test_new_search_resets_pagination_without_losing_other_controls(self):
+        for model in self.rows:
+            configured = admin.site._registry[model]
+            original = configured.list_per_page
+            configured.list_per_page = 2
+            self.addCleanup(setattr, configured, 'list_per_page', original)
+            with self.subTest(model=model.__name__):
+                first = self.page(model, {'status__exact': 'published', 'sort': 'name_asc', 'p': 2, 'q': ''})
+                controls = self.controls(first)
+                self.assertNotIn('q', [key for key, value in controls.hidden])
+                self.assertNotIn('p', [key for key, value in controls.hidden])
+                self.assertNotIn('e', [key for key, value in controls.hidden])
+                params = controls.submission('SEARCHQA')
+                self.assertEqual(params.getlist('status__exact'), ['published'])
+                response = self.page(model, params)
+                self.assertEqual(response.context['cl'].page_num, 1)
+                self.assertEqual(self.ids(response), self.rows[model][:2])
+
+    def test_hidden_values_escape_markup_and_preserve_repeated_nonvisible_filter(self):
+        unsafe = '\"><svg data-qa-search-injection=1 onload=alert(1)>'
+        for model in self.rows:
+            with self.subTest(model=model.__name__):
+                params = QueryDict(mutable=True)
+                params.setlist('name__icontains', [unsafe, 'SEARCHQA'])
+                params['sort'] = 'name_asc'
+                first = self.page(model, params)
+                submitted = self.controls(first).submission('SEARCHQA')
+                self.assertEqual(submitted.getlist('name__icontains'), [unsafe, 'SEARCHQA'])
+                self.assertNotContains(first, '<svg data-qa-search-injection')
+                self.assertEqual(self.ids(self.page(model, submitted)), self.rows[model][:3])
+
+    def test_search_does_not_expand_permissions_or_mutate_domain_records(self):
+        before = {model: list(model.objects.order_by('pk').values()) for model in self.rows}
+        actor = get_user_model().objects.create_user('search-viewer', is_staff=True)
+        actor.user_permissions.add(Permission.objects.get(content_type__app_label='catalog', codename='view_event'))
+        self.client.force_login(actor)
+        first = self.page(Event, {'status__exact': 'published', 'sort': 'name_asc'})
+        params = self.controls(first).submission('SEARCHQA')
+        self.assertEqual(self.ids(self.page(Event, params)), self.rows[Event][:2])
+        for model in (Place, Specialist):
+            self.assertEqual(self.client.get(self.url(model), params).status_code, 403)
+        self.assertEqual(before, {model: list(model.objects.order_by('pk').values()) for model in self.rows})
+
+    def test_reset_still_clears_search_status_and_sort(self):
+        for model in self.rows:
+            with self.subTest(model=model.__name__):
+                first = self.page(model, {'status__exact': 'published', 'sort': 'name_asc', 'q': 'SEARCHQA'})
+                reset = first.context['km_changelist_reset_url']
+                params = QueryDict(urlsplit(reset).query)
+                self.assertFalse({'q', 'status__exact', 'sort'} & set(params))
+                response = self.page(model, params)
+                self.assertEqual(len(self.ids(response)), 4)
