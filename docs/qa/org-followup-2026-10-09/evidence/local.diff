@@ -0,0 +1,7 @@
+const {test}=require('node:test'),assert=require('node:assert/strict'),fs=require('node:fs');
+const {JSDOM}=require('jsdom');
+const source=fs.readFileSync(require('node:path').join(__dirname,'../static/js/organization_workspace.js'),'utf8');
+function setup(){const dom=new JSDOM(`<html lang="en"><input data-branch-search><div data-branch-list>${Array.from({length:13},(_,i)=>`<div data-branch-item data-name="branch ${i+1}">branch ${i+1}</div>`).join('')}</div><nav data-branch-pagination></nav></html>`,{runScripts:'outside-only'});dom.window.HTMLElement.prototype.scrollIntoView=()=>{};dom.window.eval(source);const d=dom.window.document,nav=d.querySelector('nav');return{dom,d,nav,page:n=>[...nav.querySelectorAll('button')].find(b=>b.textContent===String(n))};}
+test('paging retains the selected control and identifies current page',()=>{const {dom,d,page}=setup();page(2).focus();page(2).click();assert.equal(d.activeElement,page(2));assert.equal(page(2).getAttribute('aria-current'),'page');page(2).click();assert.equal(d.activeElement,page(2));dom.window.close();});
+test('next and previous keep focus until disabled, then focus current page',()=>{const {dom,d,nav,page}=setup();nav.lastChild.focus();nav.lastChild.click();assert.equal(d.activeElement,nav.lastChild);nav.lastChild.click();assert.equal(d.activeElement,page(3));nav.firstChild.focus();nav.firstChild.click();assert.equal(d.activeElement,nav.firstChild);nav.firstChild.click();assert.equal(d.activeElement,page(1));dom.window.close();});
+test('filtering and initial render do not steal focus',()=>{const {dom,d,nav}=setup();assert.equal(d.activeElement,d.body);const s=d.querySelector('input');s.focus();for(const query of ['branch 13','no match','']){s.value=query;s.dispatchEvent(new dom.window.Event('input'));assert.equal(d.activeElement,s);}assert.equal(nav.style.display,'flex');dom.window.close();});
