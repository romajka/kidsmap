msgstr "Сейчас важно только заполнить основу карточки."

msgid "Обязательный минимум для связи с вами."
msgstr "Обязательный минимум для связи с вами."

msgid "Для отправки карточки достаточно телефона. Остальную информацию можно добавить по желанию."
msgstr "Для отправки карточки достаточно телефона. Остальную информацию можно добавить по желанию."

msgid "Онлайн-контакты"
msgstr "Онлайн-контакты"

msgid "Добавьте Instagram или сайт, если хотите дать больше способов связи."
msgstr "Добавьте Instagram или сайт, если хотите дать больше способов связи."

msgid "Информация о занятиях"
msgstr "Информация о занятиях"

msgid "Расписание, цены и дополнительные условия помогают родителям быстрее принять решение, но не обязательны для отправки."
msgstr "Расписание, цены и дополнительные условия помогают родителям быстрее принять решение, но не обязательны для отправки."

msgid "Сначала адрес и ориентир, потом точка на карте при необходимости."
msgstr "Сначала адрес и ориентир, потом точка на карте при необходимости."

msgid "Для отправки нужен адрес и хотя бы район или метро. Карту можно использовать, чтобы уточнить точку."
msgstr "Для отправки нужен адрес и хотя бы район или метро. Карту можно использовать, чтобы уточнить точку."

msgid "Уточнить точку на карте"
msgstr "Уточнить точку на карте"

msgid "Отметьте точку вручную или проверьте координаты по адресу. Это помогает точнее показать место, но не мешает заполнению шага."
msgstr "Отметьте точку вручную или проверьте координаты по адресу. Это помогает точнее показать место, но не мешает заполнению шага."

msgid "Проверка координат необязательна: она не создаёт карточку и не отправляет её на модерацию."
msgstr "Проверка координат необязательна: она не создаёт карточку и не отправляет её на модерацию."

msgid "Необязательно, но помогает точнее показать место."
msgstr "Необязательно, но помогает точнее показать место."

msgid "Отметьте точку вручную или проверьте координаты по адресу."
msgstr "Отметьте точку вручную или проверьте координаты по адресу."

msgid "Сначала обязательное главное фото, затем при желании дополнительные материалы."
msgstr "Сначала обязательное главное фото, затем при желании дополнительные материалы."

msgid "Главное фото обязательно. Галерею и комментарий для модерации можно добавить по желанию."
msgstr "Главное фото обязательно. Галерею и комментарий для модерации можно добавить по желанию."

msgid "Проверьте главное фото и отправьте карточку на модерацию. После проверки она появится в каталоге."
msgstr "Проверьте главное фото и отправьте карточку на модерацию. После проверки она появится в каталоге."

msgid "Дополнительные фото"
msgstr "Дополнительные фото"

msgid "Добавьте галерею, если хотите показать пространство, занятия или детали интерьера."
msgstr "Добавьте галерею, если хотите показать пространство, занятия или детали интерьера."

msgid "Напишите только если модератору нужен дополнительный контекст по карточке."
msgstr "Напишите только если модератору нужен дополнительный контекст по карточке."

msgid "Если хотите, отметьте точное место вручную. Иначе координаты можно определить по адресу."
msgstr "Если хотите, отметьте точное место вручную. Иначе координаты можно определить по адресу."

msgid "После выбора точки маркер можно перетащить."
msgstr "После выбора точки маркер можно перетащить."

msgid "Улица, дом, ориентир."
msgstr "Улица, дом, ориентир."

msgid "Обязательно для публикации."
msgstr "Обязательно для публикации."

msgid "Можно добавить позже."
msgstr "Можно добавить позже."

msgid "Например: 60 минут."
msgstr "Например: 60 минут."

msgid "Если есть отдельная цена."
msgstr "Если есть отдельная цена."

msgid "Если есть абонемент."
msgstr "Если есть абонемент."

msgid "Если есть пакет занятий."
msgstr "Если есть пакет занятий."

msgid "Только если есть важные детали."
msgstr "Только если есть важные детали."

msgid "Если модератору нужен дополнительный контекст."
msgstr "Если модератору нужен дополнительный контекст."

msgid "До 5 фото для галереи."
msgstr "До 5 фото для галереи."
